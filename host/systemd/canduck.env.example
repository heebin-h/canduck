# /etc/canduck/canduck.env 에 복사 후 값 수정
# systemd가 읽어 데몬에 환경변수로 주입.

CANDUCK_UART_DEVICE=/dev/ttyAMA0
CANDUCK_UART_BAUD=115200

CANDUCK_MQTT_HOST=localhost
CANDUCK_MQTT_PORT=1883

# Face — tkinter 표정 창 (LCD 탈락 대체). DISPLAY 없으면 no-op
CANDUCK_ENABLE_FACE=true
CANDUCK_FACE_SCALE=2

# GPIO (gpiozero, BCM 번호)
CANDUCK_ENABLE_GPIO=true

# Behavior (초) — surprised/listening은 포즈 DONE이 없어 타이머로 idle 복귀
CANDUCK_IDLE_TO_SLEEPY_SEC=600
CANDUCK_SLEEPY_TO_SLEEP_SEC=60
CANDUCK_SURPRISED_SEC=1.0
CANDUCK_LISTENING_SEC=5.0

CANDUCK_LOG_LEVEL=INFO

# Voice (선택)
CANDUCK_ENABLE_VOICE=false
CANDUCK_PORCUPINE_ACCESS_KEY=
CANDUCK_WAKE_WORD_PATH=
